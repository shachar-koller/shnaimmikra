# Copy to .env and fill in (never commit .env)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# Google's direct button (pretty consent screen with YOUR app name).
# Web client ID from Google Cloud → Credentials (ends .apps.googleusercontent.com).
# Without it, sign-in falls back to the Supabase redirect flow.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: OAuth return URL. Defaults to window.location.origin.
# VITE_AUTH_REDIRECT=https://your-app.vercel.app
