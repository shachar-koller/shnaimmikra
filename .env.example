# Copy to .env and fill in (never commit .env)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional direct Google button in the account dialog.
# Web client ID from Google Cloud → Credentials (ends .apps.googleusercontent.com).
# The welcome button uses Supabase OAuth; configure this client ID and its
# secret in Supabase's Google provider settings (never put the secret here).
# Without this variable, the account dialog also uses Supabase OAuth.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: OAuth return URL. Defaults to window.location.origin.
# VITE_AUTH_REDIRECT=https://your-app.vercel.app
